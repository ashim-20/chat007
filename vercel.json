{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/v1/models", "destination": "/api/v1/models" },
    { "source": "/v1/chat/completions", "destination": "/api/v1/chat/completions" }
  ]
}
